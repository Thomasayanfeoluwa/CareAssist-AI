# --- Required, no defaults ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
PINECONE_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_CSE_API_KEY=
PILOT_AUTH_TOKEN=

# --- Required, with defaults ---
PINECONE_INDEX=carebot
LITELLM_PRIMARY_MODEL=groq/llama-3.3-70b-versatile
LITELLM_FALLBACK_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct
CORS_ORIGINS=http://localhost:5173
REDIS_URL=

 # ---Sessions ---
SESSION_TTL_SECONDS=1800
SESSION_COOKIE_SECURE=false

# --- Ops ---
LOG_LEVEL=INFO
LLM_MOCK=true
APP_VERSION=0.1.0
REQUEST_MAX_BYTES=16384
RATE_LIMIT_PER_MINUTE=30