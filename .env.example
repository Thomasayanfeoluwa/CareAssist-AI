# --- Required, no defaults ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
PINECONE_API_KEY=
TAVILY_API_KEY=
SESSION_SECRET=
PILOT_AUTH_TOKEN=

# --- Required, with defaults ---
PINECONE_INDEX=carebot-e5
LITELLM_PRIMARY_MODEL=groq/openai/gpt-oss-120b
LITELLM_FALLBACK_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct
REDIS_URL=
CORS_ORIGINS=http://localhost:5173

# --- Ops ---
LOG_LEVEL=INFO
LLM_MOCK=false
LLM_TEMPERATURE=0.3
APP_VERSION=0.1.0
REQUEST_MAX_BYTES=16384
RATE_LIMIT_PER_MINUTE=30

# --- Session ---
SESSION_TTL_SECONDS=1800
SESSION_COOKIE_SECURE=false

# --- RAG ---
RAG_FALLBACK_SCORE_THRESHOLD=0.4
RAG_WEB_RESULTS=5