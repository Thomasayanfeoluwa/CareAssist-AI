# --- Required, no defaults ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
PINECONE_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
SESSION_SECRET=
PILOT_AUTH_TOKEN=

# --- Required, has defaults ---
